# Copia este archivo como .env y ajusta los valores.
# Los valores reales se sacan del panel de Supabase: Project Settings → Database / API.
# Nunca subas el archivo .env al repositorio.

# Puerto en el que escucha el API (Render lo define automáticamente).
PORT=3000

# Orígenes permitidos para CORS, separados por coma.
# Vacío = cualquier origen (solo para desarrollo).
CORS_ORIGINS=http://localhost:5173

# ── Base de datos (Supabase, proyecto gymtrack-unal) ─────────────────────────
# Copia las URLs exactas desde el botón "Connect" del proyecto en Supabase
# (el host del pooler puede ser aws-0-… o aws-1-…); solo reemplaza la contraseña.
# Conexión que usa el API en tiempo de ejecución: pooler en modo transacción (puerto 6543).
DATABASE_URL="postgresql://postgres.ubijemneujcpxdzwoufk:[CONTRASEÑA-BD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión para migraciones y seed: pooler en modo sesión (puerto 5432).
DIRECT_URL="postgresql://postgres.ubijemneujcpxdzwoufk:[CONTRASEÑA-BD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (solo para el seed y para validar tokens más adelante) ─────
SUPABASE_URL=https://ubijemneujcpxdzwoufk.supabase.co
# Clave secreta (service_role). Solo en el backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña que el seed asigna a los usuarios de prueba (mínimo 10 caracteres).
SEED_PASSWORD=
